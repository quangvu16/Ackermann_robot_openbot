<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/waypoint_index"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_waypoint_index"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/waypoint_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Parking spot"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/waypoint_coords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB0BEC5"
            android:textSize="12sp"
            tools:text="47.3977420, 8.5455940" />
    </LinearLayout>

    <TextView
        android:id="@+id/waypoint_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textColor="#FF80CBC4"
        android:textSize="13sp"
        tools:text="120 m" />

    <ImageButton
        android:id="@+id/waypoint_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/gps_nav_delete_waypoint"
        android:src="@drawable/ic_delete_24"
        android:tint="#FFEF5350" />
</LinearLayout>
