<?xml version="1.0" encoding="utf-8"?>
<!-- Sensor link (SensorServer WebSocket) status and settings button, shared by GPS Mission,
     Object Tracking and Autopilot. Wired up by ControlsFragment.setupSensorLinkControls(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/sensor_link_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="32dp"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/sensor_link_off"
        android:textColor="@android:color/black"
        android:textIsSelectable="true"
        android:textSize="13sp"
        tools:text="Sharing sensors at ws://192.168.1.23:8080 · 1 connected" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sensor_link_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:minWidth="0dp"
        android:text="@string/sensor_link_button"
        android:textColor="@color/openBotBlue"
        app:cornerRadius="12dp" />
</LinearLayout>
