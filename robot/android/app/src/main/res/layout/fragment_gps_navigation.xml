<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".gpsNav.GpsNavigationFragment">

    <org.openbot.app.robot.gpsNav.MissionMapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF101820" />

    <!-- HUD + map provider switcher stacked, so the readouts keep the full card
         width and the switcher can never cover them. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <!-- Mission Planner style HUD strip: mode, distance/bearing to next waypoint, GPS quality. -->
        <LinearLayout
            android:id="@+id/hud_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.92"
            android:background="@drawable/border_radius_layout"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/hud_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gps_nav_status_idle"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="IDLE" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hud_distance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/gps_nav_distance_placeholder"
                    android:textColor="#FFB0BEC5"
                    android:textSize="13sp"
                    tools:text="Dist  -- m" />

                <TextView
                    android:id="@+id/hud_bearing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/gps_nav_bearing_placeholder"
                    android:textColor="#FFB0BEC5"
                    android:textSize="13sp"
                    tools:text="Brng  --°" />

                <TextView
                    android:id="@+id/hud_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/gps_nav_speed_placeholder"
                    android:textColor="#FFB0BEC5"
                    android:textSize="13sp"
                    tools:text="Spd  -- m/s" />

                <TextView
                    android:id="@+id/hud_accuracy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/gps_nav_accuracy_placeholder"
                    android:textColor="#FFB0BEC5"
                    android:textSize="13sp"
                    tools:text="Acc  -- m" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mission Planner's map provider dropdown: tap to switch the backdrop
             between satellite, hybrid and street. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_type_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/gps_nav_map_type_satellite"
            android:textSize="12sp"
            app:backgroundTint="#E6101820"
            app:cornerRadius="18dp"
            app:icon="@android:drawable/ic_menu_mapmode"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@android:color/white"
            app:strokeColor="@android:color/white" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mission_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_bg"
        app:behavior_hideable="false"
        app:behavior_peekHeight="300dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:id="@+id/sheet_handle"
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_marginTop="12dp"
            android:alpha="0.5"
            android:background="@drawable/button_item_background_black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <HorizontalScrollView
            android:id="@+id/mission_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sheet_handle">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/start_pause_button"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/gps_nav_start" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stop_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/gps_nav_stop" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rtl_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/gps_nav_rtl" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_waypoint_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/gps_nav_add_wp_here" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clear_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/gps_nav_clear" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/gps_nav_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/import_waypoints_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/gps_nav_import_waypoints" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/export_waypoints_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/gps_nav_export_waypoints" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/export_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gps_nav_export_kml" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/mission_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:text="@string/gps_nav_mission_empty"
            android:textColor="#FF90A4AE"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mission_controls"
            tools:text="Mission: 0 waypoints" />

        <!-- Quick-disable for object avoidance. The HUD already reports a hold in the mission
             status line; this is the switch itself, kept in the sheet beside the mission buttons
             so it is in reach while driving. See object_avoidance_control.xml. -->
        <include
            android:id="@+id/object_avoidance"
            layout="@layout/object_avoidance_control"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mission_info" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/waypoint_list"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/object_avoidance"
            tools:listitem="@layout/item_waypoint" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
