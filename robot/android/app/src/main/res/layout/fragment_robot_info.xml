<?xml version="1.0" encoding="utf-8"?>
<!-- Car setup for the ESP32-S3 Ackermann car (firmware/openbot-esp32s3). It shows only what that
     car has: an ESC for throttle, a steering servo, an LD14 LiDAR (obstacle distance, 8 proximity
     sectors, full scans over USB), turn indicators, front/rear lights, status LEDs and an RC
     receiver. No battery sensor, sonar, bumpers or wheel encoders, so none are shown. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/robotTypeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:text="@string/robot_type"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/robotTypeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:text="@string/n_a"
            android:textColor="@android:color/black" />

        <CheckBox
            android:id="@+id/refreshToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/refresh_toggle"
            android:minWidth="48dp"
            android:padding="8dp"
            tools:ignore="DuplicateSpeakableTextCheck" />

        <CheckBox
            android:id="@+id/usbToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/usb_toggle"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/bleToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:button="@drawable/ble_toggle"
            android:padding="8dp" />

    </LinearLayout>

    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/robot_icon"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:contentDescription="@string/robot_icon"
        android:padding="8dp"
        android:src="@drawable/ic_openbot" />

    <TextView
        android:id="@+id/drive_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="4dp"
        android:text="@string/setup_drive_unknown"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/featuresText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-black"
        android:padding="8dp"
        android:text="@string/setup_features"
        android:textColor="@android:color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal">
            <CheckBox
                android:id="@+id/feat_lidar_obstacle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="false"
                android:minHeight="40dp"
                android:padding="4dp"
                android:text="@string/setup_feat_obstacle" />
            <CheckBox
                android:id="@+id/feat_lidar_proximity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="false"
                android:minHeight="40dp"
                android:padding="4dp"
                android:text="@string/setup_feat_proximity" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal">
            <CheckBox
                android:id="@+id/feat_lidar_scans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="false"
                android:minHeight="40dp"
                android:padding="4dp"
                android:text="@string/setup_feat_scans" />
            <CheckBox
                android:id="@+id/feat_rc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="false"
                android:minHeight="40dp"
                android:padding="4dp"
                android:text="@string/setup_feat_rc" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal">
            <CheckBox
                android:id="@+id/feat_indicators"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="false"
                android:minHeight="40dp"
                android:padding="4dp"
                android:text="@string/indicators" />
            <CheckBox
                android:id="@+id/feat_leds_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="false"
                android:minHeight="40dp"
                android:padding="4dp"
                android:text="@string/setup_feat_status_leds" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal">
            <CheckBox
                android:id="@+id/feat_leds_front"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="false"
                android:minHeight="40dp"
                android:padding="4dp"
                android:text="@string/setup_feat_front_lights" />
            <CheckBox
                android:id="@+id/feat_leds_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="false"
                android:minHeight="40dp"
                android:padding="4dp"
                android:text="@string/setup_feat_rear_lights" />
        </LinearLayout>
    </LinearLayout>

    <!-- SensorServer WebSocket link (sensor_link_control.xml). -->
    <include
        android:id="@+id/sensor_link"
        layout="@layout/sensor_link_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/readingsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-black"
        android:padding="8dp"
        android:text="@string/readings"
        android:textColor="@android:color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:padding="4dp"
                android:text="@string/setup_obstacle_ahead"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/obstacle_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="4dp"
                android:text="@string/n_a"
                android:textColor="@android:color/black"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:padding="4dp"
                android:text="@string/setup_rc_mode"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/rc_mode_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="4dp"
                android:text="@string/n_a"
                android:textColor="@android:color/black"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:padding="4dp"
                android:text="@string/setup_link"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/link_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="4dp"
                android:text="@string/n_a"
                android:textColor="@android:color/black"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/sendCommandsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-black"
        android:padding="8dp"
        android:text="@string/send_commands"
        android:textColor="@android:color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:text="@string/motors"
            android:textColor="@android:color/black" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/motors_forward_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            android:text="@string/forward"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/motors_backward_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            android:text="@string/backward"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/motors_stop_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            android:text="@string/stop"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:text="@string/setup_steering"
            android:textColor="@android:color/black" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/steer_left_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            android:text="@string/setup_left"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/steer_center_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            android:text="@string/setup_centre"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/steer_right_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            android:text="@string/setup_right"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/indicators_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:text="@string/indicators"
            android:textColor="@android:color/black" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ind_left_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            android:text="@string/setup_left"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ind_off_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            android:text="@string/setup_off"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ind_right_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/openBotBlue"
            android:minHeight="48dp"
            android:text="@string/setup_right"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="#FFFFFF"
            tools:ignore="TextContrastCheck" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:padding="4dp"
        android:text="@string/setup_test_note"
        android:textColor="#666666"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/leds_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:gravity="end"
            android:minHeight="48dp"
            android:padding="4dp"
            android:text="@string/lights"
            android:textColor="@android:color/black" />

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/lights_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:contentDescription="@string/lights_slider"
            android:padding="4dp"
            android:valueFrom="0.0"
            android:valueTo="100.0"
            app:thumbColor="@color/openBotBlue"
            app:trackColorActive="@color/openBotBlue" />


    </LinearLayout>

    <!-- Live LiDAR plan view. The plan is north-up with the car at the centre pointing up, so
         "forward" is up on screen whichever way the phone is held. The amber ring is AVOID_MARGIN.
         Bins with no return are gaps rather than zeros - "nothing measured here" is not an obstacle. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="4dp"
            android:text="@string/lidar"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <org.openbot.app.robot.customview.LidarView
            android:id="@+id/lidar_view"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_margin="8dp" />

        <TextView
            android:id="@+id/lidar_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="32dp"
            android:padding="4dp"
            android:text="@string/lidarIdle"
            android:textColor="@android:color/black"
            tools:text="360 bins · 312 returns · live" />
    </LinearLayout>

    <!-- AVOID_MARGIN analog: how far from a barrier the car holds. The quick-disable switch lives
         on the FreeRoam driving screen, where it can actually be reached in a hurry. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/avoid_margin_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:gravity="end"
            android:minHeight="48dp"
            android:padding="4dp"
            android:text="@string/avoidMargin"
            android:textColor="@android:color/black" />

        <com.google.android.material.slider.Slider
            android:id="@+id/avoid_margin_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:contentDescription="@string/avoidMargin"
            android:padding="4dp"
            android:stepSize="0.1"
            android:valueFrom="0.3"
            android:valueTo="3.0"
            app:thumbColor="@color/openBotBlue"
            app:trackColorActive="@color/openBotBlue" />

        <TextView
            android:id="@+id/avoid_margin_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minHeight="32dp"
            android:padding="4dp"
            android:textColor="@android:color/black"
            tools:text="1.0 m" />
    </LinearLayout>

    <!-- AVOID_BACKUP_SPD analog: reverse command used to back away and restore the margin when
         something closes in from the front. 0 (the ArduPilot default) disables backing away. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/avoid_backup_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:gravity="end"
            android:minHeight="48dp"
            android:padding="4dp"
            android:text="@string/avoidBackup"
            android:textColor="@android:color/black" />

        <com.google.android.material.slider.Slider
            android:id="@+id/avoid_backup_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:contentDescription="@string/avoidBackup"
            android:padding="4dp"
            android:stepSize="0.05"
            android:valueFrom="0.0"
            android:valueTo="0.5"
            app:thumbColor="@color/openBotBlue"
            app:trackColorActive="@color/openBotBlue" />

        <TextView
            android:id="@+id/avoid_backup_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minHeight="32dp"
            android:padding="4dp"
            android:textColor="@android:color/black"
            tools:text="Off" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
