<?xml version="1.0" encoding="utf-8"?>
<!-- Indoor SLAM & navigation: the RViz-style map on top, controls below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.25">

        <org.openbot.app.robot.slam.SlamMapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top-left: the top-right corner belongs to the STOP button. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/center_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:minWidth="0dp"
            android:contentDescription="@string/slam_center"
            android:tooltipText="@string/slam_center"
            app:backgroundTint="#E6FFFFFF"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_btn_center_focus_strong"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:id="@+id/map_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="#B3000000"
            android:padding="6dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            tools:text="x 1.20 m, y 0.40 m, 15° · match 82% · 340 scans" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:textColor="@color/black_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Driving to the goal: 2.1 m to go" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mode_map"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/slam_mode_map"
                    android:tooltipText="@string/slam_mode_map"
                    app:icon="@drawable/ic_btn_map"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="24dp"
                    android:minWidth="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mode_localize"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/slam_mode_localize"
                    android:tooltipText="@string/slam_mode_localize"
                    app:icon="@drawable/ic_btn_my_location"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="24dp"
                    android:minWidth="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/explore_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/slam_explore"
                    android:tooltipText="@string/slam_explore"
                    app:backgroundTint="@color/openBotBlue"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_btn_travel_explore"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="32dp"
                    android:minWidth="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancel_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:contentDescription="@string/slam_cancel"
                    android:tooltipText="@string/slam_cancel"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_btn_close"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="24dp"
                    android:minWidth="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/algorithms_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/slam_algorithms"
                        android:tooltipText="@string/slam_algorithms"
                        app:icon="@drawable/ic_btn_tune"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        android:minWidth="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/find_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/slam_find"
                        android:tooltipText="@string/slam_find"
                        app:icon="@drawable/ic_btn_location_searching"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        android:minWidth="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/save_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/slam_save"
                        android:tooltipText="@string/slam_save"
                        app:icon="@drawable/ic_btn_save"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        android:minWidth="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/load_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/slam_load"
                        android:tooltipText="@string/slam_load"
                        app:icon="@drawable/ic_btn_folder_open"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        android:minWidth="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clear_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/slam_clear"
                        android:tooltipText="@string/slam_clear"
                        app:icon="@drawable/ic_btn_delete"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        android:minWidth="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/export_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:contentDescription="@string/slam_export"
                        android:tooltipText="@string/slam_export"
                        app:icon="@drawable/ic_btn_ios_share"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        android:minWidth="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/layers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/layer_map"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/slam_layer_map" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/layer_scan"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/slam_layer_scan" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/layer_path"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/slam_layer_path" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/layer_trail"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/slam_layer_trail" />
            </com.google.android.material.chip.ChipGroup>

            <!-- SensorServer WebSocket link (sensor_link_control.xml). In server mode the browser
                 dashboard also gets this screen on /slam: map, car, path; click the map to set a goal. -->
            <include
                android:id="@+id/sensor_link"
                layout="@layout/sensor_link_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/source_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/black_text"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/slam_help"
                android:textColor="#FF5F6368"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
